# ---- Database (PostgreSQL lokal) ----
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mindmap
DB_HOST=localhost
DB_PORT=5432

# ---- Server ----
PORT=3000
NODE_ENV=development
JWT_SECRET=ganti-saya-jadi-string-panjang-random
SESSION_SECRET=ganti-saya-juga
COOKIE_SECRET=ganti-saya-juga

# ---- Frontend URL (untuk CORS) ----
# Saat dev, frontend Vite jalan di 5173
API_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ---- Security ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---- LLM Provider ----
# Pilih: mock (default, jalan tanpa API key) | anthropic | openai
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: override model default
# LLM_MODEL=claude-sonnet-4-6
